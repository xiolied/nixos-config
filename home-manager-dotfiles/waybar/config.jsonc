{
  "layer": "top",
  "margin-top": 0,
  "margin-left": 0,
  "margin-right": 0,
  "position": "top",

  "modules-left": [
    "custom/os-icon",
    "custom/sep",
    "clock",
    "custom/sep",
    "sway/window",
  ],
  "modules-center": ["sway/workspaces"],
  "modules-right": [
    "tray",
    "custom/sep",
    "custom/warp",
    "memory",
    "network",
    "bluetooth",
    "battery",
  ],

  "custom/os-icon": {
    "format": "󱄅",
    "tooltip": false,
  },

  "custom/sep": {
    "format": "│",
    "tooltip": false,
  },

  "sway/window": {
    "format": "{}",
    "max-length": 25,
  },

  "custom/warp": {
    "exec": "/home/oli/.config/waybar/scripts/warp-toggle.sh status",
    "on-click": "/home/oli/.config/waybar/scripts/warp-toggle.sh toggle",
    "interval": 5,
    "return-type": "json",
    "format": "{}",
  },

  "sway/workspaces": {
    "format": "{icon}",
    "persistent-workspaces": {
      "1": [],
      "2": [],
      "3": [],
      "4": [],
      "5": [],
      "6": [],
      "7": [],
    },
    "format-icons": {
      "1": "I",
      "2": "II",
      "3": "III",
      "4": "IV",
      "5": "V",
      "6": "VI",
      "7": "VII",
      "focused": "󱓻",
      "default": "",
    },
  },
  "battery": {
    "format": "{icon}",
    "format-icons": {
      "default": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
      "charging": ["󰢟", "󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"],
    },
    "tooltip-format": "{capacity}%",
  },

  "clock": {
    "format": "{:%a, %d - %H:%M}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "on-scroll": 1,
      "format": {
        "months": "<span color='#ffead3'><b>{}</b></span>",
        "days": "<span color='#ffead3'><b>{}</b></span>",
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "today": "<span color='#ff6699'><b><u>{}</u></b></span>",
      },
    },
    "actions": {
      "on-click-right": "mode",
    },
  },

  "memory": {
    "interval": 10,
    "format": "",
    "on-click": "foot btop",
    "tooltip": true,
    "tooltip-format": "RAM: {used:0.1f}GiB / {total:0.1f}GiB ({percentage}%)",
    "states": {
      "critical": 85,
    },
  },

  "network": {
    "format": "󱛇",
    "format-wifi": "󱚻",
    "format-disconnected": "󰖪",
    "max-length": 50,
    "tooltip-format": "{essid}({signalStrength}%",
    "on-click": "nmgui || kill nmgui",
  },

  "bluetooth": {
    "format": "󰂲",
    "format-disabled": "󰂲 Off",
    "format-connected": "󰂰",
    "tooltip-format-connected": "{device_alias}",
    "tooltip-format": "Not Conncted",
  },
  "tray": {
    "icon-size": 21,
    "spacing": 10,
  },
}
