* {
  font:   "JetBrainsMono Nerd Font Medium 13";

  bg-inputbar   : #13110e;
  bg-main       : #1b1814;
  bg2           : #282828;
  bg3           : #383838;
  fg0           : #b4ae9e;
  fg1           : #b0b0b0;
  fg2           : #686868;
  urgent        : #c86464;
  accent        : #b4ae9e;

  background-color : transparent;
  text-color       : @fg0;

  margin  : 0;
  padding : 0;
  spacing : 0;
}

configuration {
  show-icons: true;
  drun-display-format: "{name}";
}

element-icon, element-text, scrollbar {
  cursor: pointer;
}

window {
  location : center;
  width    : 480px;
  x-offset : 0;
  y-offset : 0;

  background-color: @bg-main;
  border: 1px;
  border-color: @bg3;
  border-radius: 4px;
}

inputbar {
  spacing  : 8px;
  padding  : 8px 12px;
  children : [ prompt, entry ];
  background-color: @bg-inputbar;
}

prompt {
  text-color: @accent;
  padding: 0px 4px 0px 0px;
}

prompt, entry, element-icon, element-text {
  vertical-align: 0.5;
}

textbox {
  padding          : 4px 8px;
  background-color : @bg2;
}

listview {
  padding      : 4px 0px;
  lines        : 9;
  columns      : 1;
  scrollbar    : true;
  fixed-height : false;
  dynamic      : true;
}

element {
  padding  : 5px 8px;
  spacing  : 8px;
  children : [ element-icon, element-text ];
}

element normal urgent {
  text-color: @urgent;
}

element normal active {
  text-color: @accent;
}

element alternate active {
  text-color: @accent;
}

element selected {
  text-color       : @bg-main;
  background-color : @accent;
}

element selected urgent {
  background-color: @urgent;
}

element-icon {
  size: 1.1em;
}

element-text {
  text-color: inherit;
}

scrollbar {
  handle-width : 4px;
  handle-color : @fg2;
  padding      : 0 4px;
}
